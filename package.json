{
  "name": "transparker",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "transparker": "npm/bin/transparker"
  },
  "files": [
    "dist/bin/*",
    "npm/bin/transparker",
    "launchd/com.transparker.api.plist",
    "scripts/install-launch-agent.sh",
    "scripts/restart.sh",
    "scripts/uninstall-launch-agent.sh",
    "README.md",
    "LICENSE",
    "PROMPT.md",
    "WORDLIST.md"
  ],
  "scripts": {
    "install:local": "./scripts/install.sh",
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build:bin": "./scripts/build-binaries.sh",
    "prepack": "bun run build:bin",
    "lint": "bun run lint:dprint:fix && bun run lint:oxlint:fix && bun run typecheck && bun run jscpd && bun run knip",
    "lint-dry": "bun run lint:dprint && bun run lint:oxlint && bun run typecheck && bun run jscpd && bun run knip",
    "lint:dprint": "dprint check",
    "lint:oxlint": "oxlint --type-aware --tsconfig tsconfig.json .",
    "lint:dprint:fix": "dprint fmt",
    "lint:oxlint:fix": "oxlint --type-aware --tsconfig tsconfig.json --fix .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "jscpd": "jscpd --config .jscpd.json",
    "knip": "knip",
    "check": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "bun-types": "^1.3.9",
    "dprint": "^0.52.0",
    "jscpd": "^4.0.8",
    "knip": "^5.85.0",
    "oxlint": "^1.50.0",
    "oxlint-plugin-inhuman": "^0.1.7",
    "oxlint-tsgolint": "^0.15.0",
    "typescript": "^5.9.2"
  }
}
