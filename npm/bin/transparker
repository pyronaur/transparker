#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  transparker [serve|start]
  transparker install-service
  transparker restart-service
  transparker uninstall-service
  transparker help
EOF
}

resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  while [[ -L "${source}" ]]; do
    local dir
    dir="$(cd -P "$(dirname "${source}")" && pwd)"
    source="$(readlink "${source}")"
    if [[ "${source}" != /* ]]; then
      source="${dir}/${source}"
    fi
  done
  cd -P "$(dirname "${source}")" && pwd
}

script_dir="$(resolve_script_dir)"
package_root="$(cd "${script_dir}/../.." && pwd)"

platform="$(uname -s)"
arch="$(uname -m)"
command="${1:-serve}"
if [[ $# -gt 0 ]]; then
  shift
fi

detect_linux_libc() {
  if ! command -v ldd >/dev/null 2>&1; then
    echo "unknown"
    return
  fi

  if ldd --version 2>&1 | grep -qi "musl"; then
    echo "musl"
    return
  fi

  if ldd --version 2>&1 | grep -qi "glibc\|gnu libc"; then
    echo "glibc"
    return
  fi

  echo "unknown"
}

binary_candidates=()
case "${platform}" in
  Darwin)
    case "${arch}" in
      arm64|aarch64)
        binary_candidates+=("transparker-darwin-arm64")
        ;;
      x86_64|amd64)
        binary_candidates+=("transparker-darwin-x64")
        ;;
    esac
    ;;
  Linux)
    linux_libc="$(detect_linux_libc)"
    case "${arch}" in
      arm64|aarch64)
        if [[ "${linux_libc}" == "musl" ]]; then
          binary_candidates+=("transparker-linux-arm64-musl" "transparker-linux-arm64")
        else
          binary_candidates+=("transparker-linux-arm64" "transparker-linux-arm64-musl")
        fi
        ;;
      x86_64|amd64)
        if [[ "${linux_libc}" == "musl" ]]; then
          binary_candidates+=("transparker-linux-x64-musl" "transparker-linux-x64")
        else
          binary_candidates+=("transparker-linux-x64" "transparker-linux-x64-musl")
        fi
        ;;
    esac
    ;;
esac

binary_path=""
for candidate in "${binary_candidates[@]}"; do
  candidate_path="${package_root}/dist/bin/${candidate}"
  if [[ -x "${candidate_path}" ]]; then
    binary_path="${candidate_path}"
    break
  fi
done

use_bun_fallback=0
if [[ "${command}" == "serve" || "${command}" == "start" ]]; then
  if [[ -z "${binary_path}" || ! -x "${binary_path}" ]]; then
    if command -v bun >/dev/null 2>&1 && [[ -f "${package_root}/src/server.ts" ]]; then
      binary_path="bun"
      use_bun_fallback=1
    else
      echo "Unsupported platform or missing transparker binary for ${platform}/${arch}."
      exit 1
    fi
  fi
fi

export TRANSPARKER_PROJECT_ROOT="${TRANSPARKER_PROJECT_ROOT:-${package_root}}"

run_service_command() {
  local action="${1}"
  shift || true

  case "${platform}" in
    Darwin)
      case "${action}" in
        install)
          exec "${package_root}/scripts/install-launch-agent.sh" "$@"
          ;;
        restart)
          exec "${package_root}/scripts/restart.sh" "$@"
          ;;
        uninstall)
          exec "${package_root}/scripts/uninstall-launch-agent.sh" "$@"
          ;;
      esac
      ;;
    Linux)
      case "${action}" in
        install)
          exec "${package_root}/scripts/install-systemd-user-service.sh" "$@"
          ;;
        restart)
          exec "${package_root}/scripts/restart-systemd-user-service.sh" "$@"
          ;;
        uninstall)
          exec "${package_root}/scripts/uninstall-systemd-user-service.sh" "$@"
          ;;
      esac
      ;;
    *)
      echo "Service management is supported on macOS and Linux only."
      exit 1
      ;;
  esac
}

case "${command}" in
  serve|start)
    if [[ "${use_bun_fallback}" -eq 1 ]]; then
      exec "${binary_path}" "${package_root}/src/server.ts" "$@"
    fi
    exec "${binary_path}" "$@"
    ;;
  install-service)
    run_service_command install "$@"
    ;;
  restart-service)
    run_service_command restart "$@"
    ;;
  uninstall-service)
    run_service_command uninstall "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown transparker command: ${command}"
    echo
    usage
    exit 1
    ;;
esac
